# SyllabusTrace-CS Environment Configuration

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Pluggable AI Providers (Optional - Local deterministic engine runs without any key!)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default Active Model Provider: 'mock' (default offline deterministic), 'gemini', 'openai', or 'anthropic'
AI_PROVIDER=mock
MODEL_NAME=deterministic-baseline-v1

# Storage Paths (relative or absolute)
DATA_DIR=./data
REPORTS_DIR=./data/reports
